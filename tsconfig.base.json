{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"ignoreDeprecations": "6.0",
		"paths": {
			"@retail/database": ["./packages/database/src/index.ts"],
			"@retail/types": ["./packages/types/src/index.ts"]
		}
	},
	"exclude": ["node_modules", "tmp"]
}
