{
	"name": "retail-platform",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"start": "npx nx run-many --target=dev --all",
		"start:admin": "npm run dev --workspace=apps/admin-dashboard",
		"start:pos": "npm run dev --workspace=apps/pos",
		"start:gasoline": "cd apps/gasoline-web && node ../../node_modules/next/dist/bin/next dev -p 3003",
		"build": "npx nx run-many --target=build --all",
		"build:admin": "npm run build --workspace=apps/admin-dashboard",
		"build:pos": "npm run build --workspace=apps/pos",
		"build:gasoline": "npm run build --workspace=apps/gasoline-web",
		"db:migrate": "npm run db:migrate --workspace=packages/database",
		"db:migrate:staging": "npm run db:migrate:staging --workspace=packages/database",
		"db:seed": "npm run db:seed --workspace=packages/database",
		"db:seed:staging": "npm run db:seed:staging --workspace=packages/database",
		"format": "npx prettier --write .",
		"lint": "npx nx run-many --target=lint --all",
		"test": "npx nx run-many --target=test --all",
		"nx": "nx"
	},
	"devDependencies": {
		"nx": "^20.8.4",
		"typescript": "^7.0.2"
	}
}
