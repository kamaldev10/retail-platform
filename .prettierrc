{
	"endOfLine": "auto",
	"printWidth": 100,
	"htmlWhitespaceSensitivity": "ignore",
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "avoid"
}
